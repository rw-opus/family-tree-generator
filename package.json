{
  "name": "family-tree-generator",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "24.19.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/precompress.mjs && node scripts/write-build-info.mjs",
    "preview": "vite preview",
    "start": "node server.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run build && npm test && npm run test:e2e",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "test:rls": "vitest run --config vitest.security.config.js"
  },
  "dependencies": {
    "@sentry/browser": "10.64.0",
    "@supabase/supabase-js": "2.110.8",
    "lucide-react": "0.511.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "15.15.0",
    "jsdom": "25.0.1",
    "prettier": "3.9.6",
    "vite": "6.4.3",
    "vitest": "4.1.10"
  }
}

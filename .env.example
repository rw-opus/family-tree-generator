# Development-only override. Production builds always require Supabase and fail closed.
VITE_COMMERCIAL_MODE=false
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional privacy-reduced client error monitoring. Configure only after the
# monitoring project's retention, region and access settings have been agreed.
# VITE_SENTRY_DSN=

# Stripe and Supabase secret keys belong in Supabase Edge Function secrets,
# never in this Vite/browser environment file.
